[gd_resource type="ShaderMaterial" format=3 uid="uid://buh6uaww5rtsq"]

[ext_resource type="Texture2D" uid="uid://drijhg0g7ak1n" path="res://assets/PlayerCharacter/GodotPlush/Material/godot_plush_albedo.png" id="2_532ik"]
[ext_resource type="Texture2D" uid="uid://dts2qgujqag2b" path="res://assets/PlayerCharacter/GodotPlush/Material/godot_plush_normal.png" id="3_3n74y"]

[sub_resource type="Shader" id="Shader_dqvdr"]
code = "shader_type spatial;

uniform sampler2D albedo_texture : source_color, repeat_disable;
uniform sampler2D normal_texture : hint_normal, repeat_disable;
uniform vec2 uv_offset = vec2(0.0);

uniform vec3 target_color : source_color = vec3(0.0, 0.0, 1.0);
uniform vec3 remap_color : source_color = vec3(1.0);

float fresnel(float amount, vec3 normal, vec3 view)
{
	return pow((1.0 - clamp(dot(normalize(normal), normalize(view)), 0.0, 1.0 )), amount);
}

void fragment() {
	vec3 tex_color = texture(albedo_texture, UV + uv_offset).rgb;
	float r = tex_color.r;
	float g = tex_color.g;
	float b = tex_color.b;
	
	float max_val = max(r, max(g, b));
	float min_val = min(r, min(g, b));
	float delta = max_val - min_val;
	
	if (delta > 0.9)
	{
		tex_color = remap_color;
	}
	
	ALBEDO = tex_color;
	NORMAL_MAP = texture(normal_texture, UV + uv_offset).xyz;
	EMISSION = mix(vec3(1.0), ALBEDO, 0.75) * clamp(smoothstep(0.6, 0.7, fresnel(1.0, NORMAL, VIEW)) * NORMAL.y, 0.0, 1.0) * 2.0;
	ROUGHNESS = 0.7;
	SPECULAR = 0.8;
}
"

[resource]
resource_local_to_scene = true
render_priority = 0
shader = SubResource("Shader_dqvdr")
shader_parameter/albedo_texture = ExtResource("2_532ik")
shader_parameter/normal_texture = ExtResource("3_3n74y")
shader_parameter/uv_offset = Vector2(0, 0)
shader_parameter/target_color = Color(0.09411765, 0.6, 1, 1)
shader_parameter/remap_color = Color(0.09411765, 0.6, 1, 1)
