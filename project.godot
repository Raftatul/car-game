; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Network]

general/instances_count=1.0
general/net_mode=1

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Multiplayer Template"
run/main_scene="uid://b75a7qx0ntove"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MultiplayerBackend="*res://src/modules/multiplayer/multiplayer_backend.gd"
Global="*res://src/modules/windows_placement/global.gd"
MultiplayerUtility="*uid://ckr0l5f570wmc"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[editor]

run/main_run_args="--no-header"

[editor_plugins]

enabled=PackedStringArray("res://addons/PathMesh3D/plugin.cfg", "res://addons/halyard/plugin.cfg", "res://addons/multiplayer_shortcuts/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://src/": "red"
}

[global_group]

spawn_point=""
fish=""
players=""

